# ==============================================================================
# Kirana Ledger Digitizer - Environment Configuration Template
# NOTE: Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file or any secrets to version control.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=true

# Default Interface Language (kn = Kannada, en = English, hi = Hindi, te = Telugu, ta = Tamil)
DEFAULT_LANGUAGE=kn

# Gemma 4 / Google GenAI Configuration
# Obtain your API key from Google AI Studio
GEMMA_API_KEY=your_gemma_api_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_MODEL_NAME=gemma-4-26b-a4b-it

# Supabase PostgreSQL Configuration
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_actual_secret_key

# RapidFuzz Catalog Matching Threshold (0 - 100)
CATALOG_MATCH_THRESHOLD=75.0

# Storage & Upload Settings
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=15

# Vision Preprocessing & Performance Tunables
MAX_IMAGE_DIMENSION=1600
IMAGE_QUALITY=88
GEMMA_TIMEOUT_SECONDS=35
